{
  "manifest_version": 3,
  "name": "Google Calendar グループ切替",
  "version": "3.16.0",
  "description": "Googleカレンダーのサイドバーのカレンダーをグルーピングし、グループ単位で表示ON/OFFできます。",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://calendar.google.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
